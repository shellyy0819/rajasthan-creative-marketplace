{
  "name": "rajasthan-creative-marketplace",
  "version": "0.2.0",
  "private": true,
  "description": "Next.js marketplace for India handmade products and creative workshops",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "seo:check": "node scripts/seo-check.mjs",
    "docker:build": "docker build --target runner -t rr-api .",
    "docker:up": "docker compose -f docker-compose.prod.yml --env-file .env.backend up -d --build",
    "docker:down": "docker compose -f docker-compose.prod.yml --env-file .env.backend down",
    "docker:logs": "docker compose -f docker-compose.prod.yml --env-file .env.backend logs -f api",
    "docker:seed": "docker compose -f docker-compose.prod.yml --env-file .env.backend run --rm migrate npx tsx scripts/db-seed.ts",
    "db:up": "docker compose --env-file .env.local up -d --wait db",
    "db:down": "docker compose --env-file .env.local down",
    "db:logs": "docker compose --env-file .env.local logs -f db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-seed.ts --reset",
    "test:pg": "node --env-file=.env.local node_modules/vitest/vitest.mjs run tests/pg-concurrency.test.ts",
    "test:layout": "playwright test -c playwright.layout.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "~3.1161.0",
    "@aws-sdk/s3-presigned-post": "~3.1161.0",
    "@tanstack/react-query": "~5.106.0",
    "drizzle-orm": "~0.45.4",
    "next": "16.4.1",
    "next-auth": "~4.24.15",
    "nodemailer": "~7.0.13",
    "postgres": "~3.4.9",
    "react": "~19.3.0",
    "react-dom": "~19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "~0.5.10",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/react": "~16.3.3",
    "@types/node": "~26.6.5",
    "@types/nodemailer": "~7.0.12",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "drizzle-kit": "~0.31.11",
    "jsdom": "~30.1.2",
    "tsx": "~4.23.15",
    "typescript": "~7.0.2",
    "vitest": "~5.0.4"
  }
}
