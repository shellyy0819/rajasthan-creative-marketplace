{
  "name": "rajasthan-creative-marketplace",
  "version": "0.2.0",
  "private": true,
  "description": "Next.js marketplace for Rajasthan handmade products and creative workshops",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "seo:check": "node scripts/seo-check.mjs",
    "docker:build": "docker build --target runner -t rr-api .",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-seed.ts --reset",
    "test:pg": "PG_TEST_URL=postgres://rr:rr_dev_password@localhost:5434/postgres vitest run tests/pg-concurrency.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "~0.45.4",
    "next": "~16.4.0",
    "next-auth": "~4.24.15",
    "postgres": "~3.4.9",
    "react": "~19.3.0",
    "react-dom": "~19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "~0.5.10",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/react": "~16.3.3",
    "@types/node": "~26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "drizzle-kit": "~0.31.11",
    "jsdom": "~30.1.2",
    "tsx": "~4.23.15",
    "typescript": "~7.0.2",
    "vitest": "~5.0.4"
  }
}
