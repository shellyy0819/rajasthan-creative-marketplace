# Backend (Docker) environment. Copy to .env.backend (git-ignored) and fill in.
# Generate NEXTAUTH_SECRET with: openssl rand -base64 48 (required; compose refuses to start if empty).

# Neon: use the POOLED string (host contains "-pooler") for the running API.
# Remove "&channel_binding=require" from Neon's string; keep sslmode=require.
DATABASE_URL=
# Optional: DIRECT Neon string (no "-pooler") used only by the migrate step. Defaults to DATABASE_URL.
MIGRATE_DATABASE_URL=

NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google emails that get the admin role
ADMIN_EMAILS=
# Public URL users will visit (set when the frontend deployment is decided)
NEXTAUTH_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Host port the API listens on (127.0.0.1 only; put a reverse proxy in front)
API_PORT=3001

# --- Optional: dashboard on its own subdomain (same deployment, see docs/subdomains.md) ---
# The public site is NEXT_PUBLIC_SITE_URL (e.g. https://www.example.com). The dashboard host:
DASHBOARD_URL=
# Cookie domain shared by both hosts so one login works on both (e.g. .example.com)
COOKIE_DOMAIN=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Empty = analytics and the cookie banner are off.
GA_MEASUREMENT_ID=

# Optional: salt for the daily hash that counts unique visitors for trending (no IP is stored). Set a long random value in production.
# ANALYTICS_SALT=

# Product photos on S3 (see docs/product-images.md). Leave empty to keep uploads switched off.
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: public address if you use a CDN or custom domain, and a folder prefix such as dev/
# S3_PUBLIC_BASE_URL=
# S3_KEY_PREFIX=


# Public contact email (footer For makers link, /contact, /coming-soon, structured data). Optional: the default is hello.craftofy@gmail.com.
# CONTACT_EMAIL=
