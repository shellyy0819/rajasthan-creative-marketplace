NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Auth (NextAuth v4 + Google). Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=            # generate: openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google emails that get the admin role
ADMIN_EMAILS=

# Postgres in Docker: `npm run db:up` (localhost:5433; 5432 is left free for any local Postgres).
# These are local-development credentials only.
DATABASE_URL=postgres://rr:rr_dev_password@localhost:5433/rajasthan
