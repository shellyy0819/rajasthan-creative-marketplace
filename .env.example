NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Auth (NextAuth v4 + Google). Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=            # generate: openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google emails that get the admin role
ADMIN_EMAILS=

# Local Postgres in Docker: `npm run db:up` (localhost:${DB_PORT}; 5432 is left free for any local Postgres).
# Pick your own password; keep DATABASE_URL and PG_TEST_URL in sync with these values.
POSTGRES_USER=rr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rajasthan
DB_PORT=5434
DATABASE_URL=postgres://rr:change-me@localhost:5434/rajasthan
# Used only by `npm run test:pg` (concurrency tests create and drop scratch databases here; never point at production)
PG_TEST_URL=postgres://rr:change-me@localhost:5434/postgres
